#!/usr/bin/env zsh

if [ -f cidfile ] ; then
  echo cidfile exists
  exit 1
fi

CONFIG=${CONFIG:-$HOME/valheim-server/config}
DATA=${DATA:-$HOME/valheim-server/data}
SERVER_PASS=${SERVER_PASS:-pickl3s}

mkdir -p $CONFIG/worlds $DATA

podman run -d \
  --cidfile cidfile \
  --name valheim-server \
  --cap-add=sys_nice \
  --stop-timeout 120 \
  -p 2456-2457:2456-2457/udp \
  -v $CONFIG:/config \
  -v $DATA:/opt/valheim \
  -e SERVER_NAME="Bingecraft" \
  -e WORLD_NAME="Revolution" \
  -e SERVER_PASS="$SERVER_PASS" \
  ghcr.io/lloesche/valheim-server:sha-20e6258
